# Copy to .env.local for local dev. On Vercel, set these in Settings → Environment Variables.

# ── Storage (added automatically when you connect Upstash for Redis in Vercel Storage)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=      # alternative names, either pair works
# UPSTASH_REDIS_REST_TOKEN=

# ── Security (set all of these in production)
TOOL_SECRET=                   # long random string; sent by ElevenLabs tools as the x-vela-secret header
DEMO_KEY=                      # locks seed / reset / rehearsal and /api/telegram/setup; pass as ?key=...
ELEVENLABS_WEBHOOK_SECRET=     # from the post-call webhook you create in ElevenLabs
TELEGRAM_WEBHOOK_SECRET=       # any random string (letters, digits, _ and -)

# ── ElevenLabs
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=            # optional; keeps the agent private

# ── Telegram
TELEGRAM_DOCTOR_BOT_TOKEN=
TELEGRAM_DOCTOR_CHAT_ID=       # optional; pins the doctors' group so /vincular in another group can't re-link it
TELEGRAM_PATIENT_BOT_USERNAME= # optional; shows "Message Vela on Telegram" on /call

# ── Email: Gmail SMTP ...
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# ... or Resend
RESEND_API_KEY=
EMAIL_FROM=

# ── Optional
APP_URL=                       # override the public URL (defaults to the Vercel production domain)
INVIMA_CUM_DATASET_ID=         # defaults to i7cb-raxc on datos.gov.co
